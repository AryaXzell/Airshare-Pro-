# ==============================================================================
# AirShare Pro - Environment Configuration Specification
# ==============================================================================
# Copy this file to .env or configure these variables in your hosting dashboard.
# NEVER commit real credentials, API keys, or userhashes to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OPTIONAL: Catbox Storage Provider Configuration (Server-Only)
# ------------------------------------------------------------------------------
# CATBOX_USERHASH:
# Account userhash from your Catbox.moe account.
# - If provided: Uploads are linked to your Catbox account, enabling server-side file deletion.
# - If empty or omitted: Uploads proceed anonymously to Catbox (public storage, deletion via API not supported).
CATBOX_USERHASH=

# MAX_UPLOAD_SIZE:
# Maximum allowed file upload size in bytes.
# CATATAN KRITIS VERCEL: Vercel Serverless Functions memiliki batasan fisik payload body maksimal 4.5MB
# yang TIDAK BISA dinaikkan. Selama arsitektur aplikasi mengalirkan file melalui serverless function Vercel,
# nilai ini TIDAK BOLEH diset lebih dari ~4MB (4194304 atau 4200000 bytes).
# Jika diset lebih besar saat berjalan di Vercel (process.env.VERCEL), aplikasi akan otomatis membatasi (clamp) ke 4.2MB
# guna mencegah error 413 Function Payload Too Large bawaan Vercel yang tidak tertangani.
# Default aman untuk Vercel: 4194304 (4MB). Untuk deployment non-Vercel (container/VPS mandiri), dapat diset hingga 200MB (209715200).
MAX_UPLOAD_SIZE=4194304

# CATBOX_TIMEOUT_MS:
# Upstream HTTP timeout for Catbox API requests in milliseconds.
# Default: 60000 (60 seconds).
CATBOX_TIMEOUT_MS=60000

# RATE_LIMIT_MAX_UPLOADS_PER_MIN:
# Sliding-window rate limit: Maximum number of upload requests allowed per IP per minute.
# Default: 20
RATE_LIMIT_MAX_UPLOADS_PER_MIN=20

# ------------------------------------------------------------------------------
# 2. OPTIONAL: Upstash Redis (Production Distributed Storage & Rate Limiting)
# ------------------------------------------------------------------------------
# Dapatkan gratis dari console.upstash.com:
# - Buat database Redis baru
# - Salin REST URL dan REST Token
# - Jika tidak diisi, sistem otomatis fallback ke in-memory storage & limiter (ideal untuk local dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------------------------
# 3. RUNTIME ENVIRONMENT (Auto-injected / Hosting Defaults)
# ------------------------------------------------------------------------------
# NODE_ENV:
# Application environment ('development' or 'production').
NODE_ENV=development

# PORT:
# Server listen port (defaults to 3000 in local and container environments).
PORT=3000

# APP_URL:
# Base public URL of the application (e.g., https://airshare.example.com).
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. ADMIN DASHBOARD & ANALYTICS (Server-Only, Confidential)
# ------------------------------------------------------------------------------
# WAJIB UNIK & JANGAN PERNAH DI-COMMIT KE VERSION CONTROL / DIBAGIKAN DALAM BENTUK APAPUN!
# Panel admin SELALU diakses di path tetap: /admin (tidak bisa dikustomisasi).
# Cukup set ADMIN_SECRET_KEY untuk mengaktifkannya.
# Jika ADMIN_SECRET_KEY kosong/tidak diset (< 16 karakter), panel admin akan
# menampilkan halaman panduan konfigurasi.
#
# ADMIN_SECRET_KEY:
# Kunci sandi panjang atau passphrase manusiawi minimal 16-20 karakter untuk autentikasi admin.
# Nilai dapat berupa kalimat/passphrase manusiawi asal cukup panjang (kombinasi huruf/angka/simbol disarankan).
# PENTING: Jika diisi lewat file .env lokal (bukan dashboard hosting/Vercel), value yang mengandung spasi
# WAJIB dibungkus tanda kutip ganda, contoh: ADMIN_SECRET_KEY="kunci rahasia airshare pro 2026 super aman!"
# Atau generate kunci acak hex via terminal: openssl rand -hex 32
ADMIN_SECRET_KEY=

# ------------------------------------------------------------------------------
# 5. OPTIONAL: TELEGRAM BOT ADMIN CONTROL (Server-Only)
# ------------------------------------------------------------------------------
# Menghubungkan kontrol admin panel (status, kill switch, audit log, bulk cleanup, dsb)
# ke bot Telegram privat.
#
# Default: NON-AKTIF jika TELEGRAM_BOT_TOKEN atau TELEGRAM_ADMIN_USER_IDS tidak diisi.
#
# TELEGRAM_BOT_TOKEN:
# Token API dari BotFather di Telegram.
# Cara mendapatkan:
# 1. Buka Telegram dan chat ke @BotFather
# 2. Ketik /newbot, masukkan nama dan username bot
# 3. Salin API token yang diberikan (contoh: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=

# TELEGRAM_ADMIN_USER_IDS:
# Daftar ID pengguna Telegram yang diizinkan mengontrol bot, dipisahkan koma jika lebih dari satu.
# Contoh: 123456789,987654321
# Cara mengetahui User ID Anda:
# Chat ke @userinfobot di Telegram, ID angka Anda akan ditampilkan langsung.
TELEGRAM_ADMIN_USER_IDS=

# TELEGRAM_WEBHOOK_SECRET:
# Secret token untuk memvalidasi keaslian webhook Telegram (header X-Telegram-Bot-Api-Secret-Token).
# String acak panjang yang aman (mis. 32-64 karakter alfanumerik).
# Generate via: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 6. OPTIONAL: GEMINI AI REAL-TIME SYSTEM RECOMMENDATIONS & SUMMARY (Server-Only)
# ------------------------------------------------------------------------------
# Kunci API Google Gemini untuk analisis performa real-time dan rekomendasi sistem
# bertenaga AI pada panel admin. Dapatkan gratis di https://aistudio.google.com/app/apikey
# Jika kosong/tidak diisi, sistem otomatis menggunakan mesin rekomendasi heuristik bawaan.
GEMINI_API_KEY=

# GEMINI_MODEL:
# Model AI Google Gemini yang digunakan untuk ringkasan eksekutif dan rekomendasi admin.
# Default: gemini-2.5-flash (versi stabil, responsif, dan terhindar dari lonjakan beban).
GEMINI_MODEL=gemini-2.5-flash


