# ==============================================================================
# AirShare Pro - Environment Configuration Specification
# ==============================================================================
# Copy this file to .env or configure these variables in your hosting dashboard.
# NEVER commit real credentials, API keys, or userhashes to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OPTIONAL: Catbox Storage Provider Configuration (Server-Only)
# ------------------------------------------------------------------------------
# CATBOX_USERHASH:
# Account userhash from your Catbox.moe account.
# - If provided: Uploads are linked to your Catbox account, enabling server-side file deletion.
# - If empty or omitted: Uploads proceed anonymously to Catbox (public storage, deletion via API not supported).
CATBOX_USERHASH=

# MAX_UPLOAD_SIZE:
# Maximum allowed file upload size in bytes.
# Default: 209715200 (200MB - matching Catbox limits).
MAX_UPLOAD_SIZE=209715200

# CATBOX_TIMEOUT_MS:
# Upstream HTTP timeout for Catbox API requests in milliseconds.
# Default: 60000 (60 seconds).
CATBOX_TIMEOUT_MS=60000

# RATE_LIMIT_MAX_UPLOADS_PER_MIN:
# Sliding-window rate limit: Maximum number of upload requests allowed per IP per minute.
# Default: 20
RATE_LIMIT_MAX_UPLOADS_PER_MIN=20

# ------------------------------------------------------------------------------
# 2. OPTIONAL: Upstash Redis (Production Distributed Storage & Rate Limiting)
# ------------------------------------------------------------------------------
# Dapatkan gratis dari console.upstash.com:
# - Buat database Redis baru
# - Salin REST URL dan REST Token
# - Jika tidak diisi, sistem otomatis fallback ke in-memory storage & limiter (ideal untuk local dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------------------------
# 3. RUNTIME ENVIRONMENT (Auto-injected / Hosting Defaults)
# ------------------------------------------------------------------------------
# NODE_ENV:
# Application environment ('development' or 'production').
NODE_ENV=development

# PORT:
# Server listen port (defaults to 3000 in local and container environments).
PORT=3000

# APP_URL:
# Base public URL of the application (e.g., https://airshare.example.com).
APP_URL=http://localhost:3000
