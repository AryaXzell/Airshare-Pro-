# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CATBOX_USERHASH: (Optional) User hash from your Catbox.moe account.
# If omitted or left empty, uploads are performed anonymously to Catbox.
CATBOX_USERHASH=

# MAX_UPLOAD_SIZE: (Optional) Max upload file size in bytes. Defaults to 209715200 (200MB).
MAX_UPLOAD_SIZE=209715200

# CATBOX_TIMEOUT_MS: (Optional) Timeout for Catbox upstream HTTP requests in ms. Defaults to 60000 (60s).
CATBOX_TIMEOUT_MS=60000

# RATE_LIMIT_MAX_UPLOADS_PER_MIN: (Optional) Max uploads allowed per IP per minute. Defaults to 20.
RATE_LIMIT_MAX_UPLOADS_PER_MIN=20
