{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api?__vpath=/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api?__vpath=/api/$1"
    },
    {
      "source": "/media",
      "destination": "/api?__vpath=/media"
    },
    {
      "source": "/media/(.*)",
      "destination": "/api?__vpath=/media/$1"
    },
    {
      "source": "/health",
      "destination": "/api?__vpath=/health"
    },
    {
      "source": "/system-status",
      "destination": "/api?__vpath=/system-status"
    },
    {
      "source": "/s",
      "destination": "/"
    },
    {
      "source": "/s/(.*)",
      "destination": "/api?__vpath=/s/$1"
    },
    {
      "source": "/admin",
      "destination": "/api?__vpath=/admin"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/api?__vpath=/admin/$1"
    }
  ]
}
