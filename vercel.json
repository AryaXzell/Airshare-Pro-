{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/media/(.*)",
      "destination": "/api"
    },
    {
      "source": "/s/(.*)",
      "destination": "/api?__vpath=/s/$1"
    },
    {
      "source": "/superadmin",
      "destination": "/api?__vpath=/superadmin"
    },
    {
      "source": "/superadmin/(.*)",
      "destination": "/api?__vpath=/superadmin/$1"
    },
    {
      "source": "/admin",
      "destination": "/api?__vpath=/admin"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/api?__vpath=/admin/$1"
    }
  ]
}
